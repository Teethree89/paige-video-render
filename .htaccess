# Public editor-root redirect. Apache mod_alias RedirectMatch runs at URL
# translation, before directory-level authorization can generate the host's
# verbose AH01630 error page. This never serves private data.
RedirectMatch 302 ^/Indium/paiver/\\.private(/|$) /Indium/paiver/

# Defensive fallback: mod_rewrite may be available on some 50webs setups.
RewriteEngine On
RewriteRule ^\\.private(?:/|$) /Indium/paiver/ [R=302,L,NC]

# Independent, mandatory protection is .private/.htaccess Require all denied.
# This fallback page is public, contains no secret, and returns to editor.
ErrorDocument 403 /Indium/paiver/403.html
