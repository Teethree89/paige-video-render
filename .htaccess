# Keep private URL requests away from the host's path-disclosing 403 page.
# [.] matches a literal dot in Apache regexes without backslash escaping.
# The separate .private/.htaccess Require all denied remains authoritative.
RedirectMatch 302 ^/Indium/paiver/[.]private(/|$) /Indium/paiver/

# Fallback for hosts that evaluate per-directory mod_rewrite instead.
RewriteEngine On
RewriteRule ^[.]private(/|$) /Indium/paiver/ [R=302,L,NC]

# Fallback for other forbidden resources outside the private directory.
ErrorDocument 403 /Indium/paiver/403.html
