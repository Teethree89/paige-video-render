# For operator setup only; repository deployment uses GitHub Actions secrets.
# Keep credentials out of the repository.
FTP_HOST=example.your-host.com
FTP_USER=upload-user
FTP_PASSWORD=replace-via-github-secrets
FTP_REMOTE_DIR=/paige-video-render
FTP_PORT=22
# GitHub Actions repository variable FTP_PROTOCOL: sftp (default), or ftps
# For SFTP, supply FTP_KNOWN_HOSTS as GitHub secret (verified SSH known_hosts entry)
